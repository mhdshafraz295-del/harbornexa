# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=valachchenai_harbor

# Authentication Secrets
JWT_SECRET=your_secure_jwt_secret_here
JWT_EXPIRES_IN=8h

# Cloudflare R2 Configuration (Phase 1 Architecture Foundation)
R2_ACCOUNT_ID="your_r2_account_id_here"
R2_ACCESS_KEY_ID="your_r2_access_key_id_here"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key_here"
R2_BUCKET_NAME="valachchenai-harbor-media"
# Prisma Database URL
DATABASE_URL="mysql://root:password@127.0.0.1:3306/valachchenai_harbor"

# Email Integration (IMAP for DFAR Departure Manifests)
EMAIL_HOST="imap.gmail.com"
EMAIL_PORT=993
EMAIL_USER="your_harbor_email@gmail.com"
EMAIL_PASS="your_16_digit_app_password"
EMAIL_SECURE=true

