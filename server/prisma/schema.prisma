generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admins {
  id                                                            Int                 @id @default(autoincrement())
  name                                                          String              @db.VarChar(255)
  email                                                         String              @unique(map: "email") @db.VarChar(255)
  password_hash                                                 String              @db.VarChar(255)
  role                                                          String              @default("ADMIN") @db.VarChar(50)
  status                                                        admins_status       @default(ACTIVE)
  last_login_at                                                 DateTime?           @db.DateTime(0)
  created_at                                                    DateTime            @default(now()) @db.Timestamp(0)
  updated_at                                                    DateTime            @default(now()) @db.Timestamp(0)
  audit_logs                                                    audit_logs[]
  charge_types_charge_types_created_by_admin_idToadmins         charge_types[]      @relation("charge_types_created_by_admin_idToadmins")
  charge_types_charge_types_updated_by_admin_idToadmins         charge_types[]      @relation("charge_types_updated_by_admin_idToadmins")
  clearance_records                                             clearance_records[]
  debt_payments_debt_payments_received_by_admin_idToadmins      debt_payments[]     @relation("debt_payments_received_by_admin_idToadmins")
  debt_payments_debt_payments_reversed_by_admin_idToadmins      debt_payments[]     @relation("debt_payments_reversed_by_admin_idToadmins")
  fisher_debts_fisher_debts_cancelled_by_admin_idToadmins       fisher_debts[]      @relation("fisher_debts_cancelled_by_admin_idToadmins")
  fisher_debts_fisher_debts_created_by_admin_idToadmins         fisher_debts[]      @relation("fisher_debts_created_by_admin_idToadmins")
  fisher_holds_fisher_holds_created_by_admin_idToadmins         fisher_holds[]      @relation("fisher_holds_created_by_admin_idToadmins")
  fisher_holds_fisher_holds_released_by_admin_idToadmins        fisher_holds[]      @relation("fisher_holds_released_by_admin_idToadmins")
  fisher_qr_tokens_fisher_qr_tokens_created_by_admin_idToadmins fisher_qr_tokens[]  @relation("fisher_qr_tokens_created_by_admin_idToadmins")
  fisher_qr_tokens_fisher_qr_tokens_revoked_by_admin_idToadmins fisher_qr_tokens[]  @relation("fisher_qr_tokens_revoked_by_admin_idToadmins")
  fishers                                                       fishers[]
}

model audit_logs {
  id            Int      @id @default(autoincrement())
  admin_id      Int?
  action        String   @db.VarChar(100)
  ip_address    String?  @db.VarChar(45)
  user_agent    String?  @db.Text
  metadata_json String?  @db.LongText
  created_at    DateTime @default(now()) @db.Timestamp(0)
  admins        admins?  @relation(fields: [admin_id], references: [id], onUpdate: Restrict, map: "fk_audit_logs_admin")

  @@index([admin_id], map: "fk_audit_logs_admin")
}

model charge_types {
  id                                              BigInt         @id @default(autoincrement())
  name                                            String         @unique(map: "name") @db.VarChar(100)
  default_amount                                  Decimal        @db.Decimal(12, 2)
  description                                     String?        @db.VarChar(500)
  is_active                                       Boolean        @default(true)
  created_by_admin_id                             Int
  updated_by_admin_id                             Int?
  created_at                                      DateTime       @default(now()) @db.Timestamp(0)
  updated_at                                      DateTime       @default(now()) @db.Timestamp(0)
  admins_charge_types_created_by_admin_idToadmins admins         @relation("charge_types_created_by_admin_idToadmins", fields: [created_by_admin_id], references: [id], onUpdate: Restrict, map: "fk_charge_types_created_by")
  admins_charge_types_updated_by_admin_idToadmins admins?        @relation("charge_types_updated_by_admin_idToadmins", fields: [updated_by_admin_id], references: [id], onUpdate: Restrict, map: "fk_charge_types_updated_by")
  fisher_debts                                    fisher_debts[]

  @@index([created_by_admin_id], map: "fk_charge_types_created_by")
  @@index([updated_by_admin_id], map: "fk_charge_types_updated_by")
  @@index([is_active], map: "idx_charge_types_is_active")
}

model clearance_records {
  id                        BigInt                                 @id @default(autoincrement())
  clearance_no              String                                 @unique(map: "clearance_no") @db.VarChar(30)
  fisher_id                 BigInt
  boat_no_snapshot          String?                                @db.VarChar(100)
  base_status_snapshot      clearance_records_base_status_snapshot
  outstanding_debt_snapshot Decimal                                @db.Decimal(12, 2)
  clearance_status          String                                 @db.VarChar(30)
  notes                     String?                                @db.Text
  idempotency_key           String                                 @unique(map: "idempotency_key") @db.VarChar(64)
  granted_by_admin_id       Int
  granted_at                DateTime                               @default(now()) @db.Timestamp(0)
  created_at                DateTime                               @default(now()) @db.Timestamp(0)
  fishers                   fishers                                @relation(fields: [fisher_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_clearance_fisher")
  admins                    admins                                 @relation(fields: [granted_by_admin_id], references: [id], onUpdate: Restrict, map: "fk_clearance_granted_by")

  @@index([granted_by_admin_id], map: "fk_clearance_granted_by")
  @@index([fisher_id], map: "idx_clearance_fisher_id")
  @@index([granted_at], map: "idx_clearance_granted_at")
  @@index([clearance_status], map: "idx_clearance_status")
}

model debt_payments {
  id                                                BigInt       @id @default(autoincrement())
  debt_id                                           BigInt
  fisher_id                                         BigInt
  amount                                            Decimal      @db.Decimal(12, 2)
  payment_date                                      DateTime     @db.Date
  payment_method                                    String?      @db.VarChar(50)
  reference_no                                      String?      @db.VarChar(100)
  notes                                             String?      @db.Text
  idempotency_key                                   String       @unique(map: "idempotency_key") @db.VarChar(64)
  received_by_admin_id                              Int
  reversed_at                                       DateTime?    @db.DateTime(0)
  reversed_by_admin_id                              Int?
  reversal_reason                                   String?      @db.VarChar(500)
  created_at                                        DateTime     @default(now()) @db.Timestamp(0)
  fisher_debts                                      fisher_debts @relation(fields: [debt_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_payments_debt")
  fishers                                           fishers      @relation(fields: [fisher_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_payments_fisher")
  admins_debt_payments_received_by_admin_idToadmins admins       @relation("debt_payments_received_by_admin_idToadmins", fields: [received_by_admin_id], references: [id], onUpdate: Restrict, map: "fk_payments_received_by")
  admins_debt_payments_reversed_by_admin_idToadmins admins?      @relation("debt_payments_reversed_by_admin_idToadmins", fields: [reversed_by_admin_id], references: [id], onUpdate: Restrict, map: "fk_payments_reversed_by")

  @@index([received_by_admin_id], map: "fk_payments_received_by")
  @@index([reversed_by_admin_id], map: "fk_payments_reversed_by")
  @@index([debt_id], map: "idx_payments_debt_id")
  @@index([fisher_id], map: "idx_payments_fisher_id")
  @@index([payment_date], map: "idx_payments_payment_date")
  @@index([reversed_at], map: "idx_payments_reversed_at")
}

model fisher_debts {
  id                                                BigInt              @id @default(autoincrement())
  fisher_id                                         BigInt
  charge_type_id                                    BigInt?
  category                                          String              @db.VarChar(100)
  description                                       String?             @db.Text
  original_amount                                   Decimal             @db.Decimal(12, 2)
  debt_date                                         DateTime            @db.Date
  due_date                                          DateTime?           @db.Date
  status                                            fisher_debts_status @default(OPEN)
  notes                                             String?             @db.Text
  cancelled_at                                      DateTime?           @db.DateTime(0)
  cancelled_by_admin_id                             Int?
  cancellation_reason                               String?             @db.VarChar(500)
  created_by_admin_id                               Int
  created_at                                        DateTime            @default(now()) @db.Timestamp(0)
  updated_at                                        DateTime            @default(now()) @db.Timestamp(0)
  debt_payments                                     debt_payments[]
  admins_fisher_debts_cancelled_by_admin_idToadmins admins?             @relation("fisher_debts_cancelled_by_admin_idToadmins", fields: [cancelled_by_admin_id], references: [id], onUpdate: Restrict, map: "fk_debts_cancelled_by")
  charge_types                                      charge_types?       @relation(fields: [charge_type_id], references: [id], onUpdate: Restrict, map: "fk_debts_charge_type")
  admins_fisher_debts_created_by_admin_idToadmins   admins              @relation("fisher_debts_created_by_admin_idToadmins", fields: [created_by_admin_id], references: [id], onUpdate: Restrict, map: "fk_debts_created_by")
  fishers                                           fishers             @relation(fields: [fisher_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_debts_fisher")

  @@index([cancelled_by_admin_id], map: "fk_debts_cancelled_by")
  @@index([charge_type_id], map: "fk_debts_charge_type")
  @@index([created_by_admin_id], map: "fk_debts_created_by")
  @@index([debt_date], map: "idx_debts_debt_date")
  @@index([due_date], map: "idx_debts_due_date")
  @@index([fisher_id], map: "idx_debts_fisher_id")
  @@index([status], map: "idx_debts_status")
}

model fisher_holds {
  id                                               BigInt                   @id @default(autoincrement())
  fisher_id                                        BigInt
  reason_code                                      fisher_holds_reason_code
  reason_text                                      String?                  @db.VarChar(500)
  notes                                            String?                  @db.Text
  hold_date                                        DateTime                 @db.DateTime(0)
  created_by_admin_id                              Int
  released_at                                      DateTime?                @db.DateTime(0)
  released_by_admin_id                             Int?
  release_notes                                    String?                  @db.Text
  created_at                                       DateTime                 @default(now()) @db.Timestamp(0)
  admins_fisher_holds_created_by_admin_idToadmins  admins                   @relation("fisher_holds_created_by_admin_idToadmins", fields: [created_by_admin_id], references: [id], onUpdate: Restrict, map: "fk_holds_created_by")
  fishers                                          fishers                  @relation(fields: [fisher_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_holds_fisher")
  admins_fisher_holds_released_by_admin_idToadmins admins?                  @relation("fisher_holds_released_by_admin_idToadmins", fields: [released_by_admin_id], references: [id], onUpdate: Restrict, map: "fk_holds_released_by")

  @@index([created_by_admin_id], map: "fk_holds_created_by")
  @@index([released_by_admin_id], map: "fk_holds_released_by")
  @@index([fisher_id], map: "idx_holds_fisher_id")
  @@index([reason_code], map: "idx_holds_reason_code")
  @@index([released_at], map: "idx_holds_released_at")
}

model fisher_qr_tokens {
  id                                                  BigInt    @id @default(autoincrement())
  fisher_id                                           BigInt
  token_hash                                          String    @unique(map: "token_hash") @db.VarChar(128)
  is_active                                           Boolean   @default(true)
  issued_at                                           DateTime  @db.DateTime(0)
  revoked_at                                          DateTime? @db.DateTime(0)
  revoked_by_admin_id                                 Int?
  created_by_admin_id                                 Int
  created_at                                          DateTime  @default(now()) @db.Timestamp(0)
  admins_fisher_qr_tokens_created_by_admin_idToadmins admins    @relation("fisher_qr_tokens_created_by_admin_idToadmins", fields: [created_by_admin_id], references: [id], onUpdate: Restrict, map: "fk_qr_tokens_created_by")
  fishers                                             fishers   @relation(fields: [fisher_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_qr_tokens_fisher")
  admins_fisher_qr_tokens_revoked_by_admin_idToadmins admins?   @relation("fisher_qr_tokens_revoked_by_admin_idToadmins", fields: [revoked_by_admin_id], references: [id], onUpdate: Restrict, map: "fk_qr_tokens_revoked_by")

  @@index([created_by_admin_id], map: "fk_qr_tokens_created_by")
  @@index([revoked_by_admin_id], map: "fk_qr_tokens_revoked_by")
  @@index([fisher_id], map: "idx_qr_tokens_fisher_id")
  @@index([is_active], map: "idx_qr_tokens_is_active")
  @@index([token_hash], map: "idx_qr_tokens_token_hash")
}

model fishers {
  id                  BigInt              @id @default(autoincrement())
  fisher_id           String              @unique(map: "fisher_id") @db.VarChar(20)
  full_name           String              @db.VarChar(150)
  nic                 String              @unique(map: "nic") @db.VarChar(20)
  phone               String?             @db.VarChar(20)
  boat_no             String?             @db.VarChar(100)
  address             String?             @db.Text
  notes               String?             @db.Text
  status              fishers_status      @default(ACTIVE)
  is_archived         Boolean             @default(false)
  created_by_admin_id Int?
  created_at          DateTime            @default(now()) @db.Timestamp(0)
  updated_at          DateTime            @default(now()) @db.Timestamp(0)
  clearance_records   clearance_records[]
  debt_payments       debt_payments[]
  fisher_debts        fisher_debts[]
  fisher_holds        fisher_holds[]
  fisher_qr_tokens    fisher_qr_tokens[]
  admins              admins?             @relation(fields: [created_by_admin_id], references: [id], onUpdate: Restrict, map: "fk_fishers_created_by")

  @@index([created_by_admin_id], map: "fk_fishers_created_by")
  @@index([boat_no], map: "idx_fishers_boat_no")
  @@index([full_name], map: "idx_fishers_full_name")
  @@index([is_archived], map: "idx_fishers_is_archived")
  @@index([phone], map: "idx_fishers_phone")
  @@index([status], map: "idx_fishers_status")
}

model settings {
  id            Int      @id @default(autoincrement())
  setting_key   String   @unique(map: "setting_key") @db.VarChar(100)
  setting_value String?  @db.Text
  created_at    DateTime @default(now()) @db.Timestamp(0)
  updated_at    DateTime @default(now()) @db.Timestamp(0)
}

model system_sequences {
  sequence_name String @id @db.VarChar(50)
  next_value    BigInt
}

enum fisher_holds_reason_code {
  PAYMENT_ISSUE
  DOCUMENT_ISSUE
  MANAGEMENT_DECISION
  OTHER
}

enum clearance_records_base_status_snapshot {
  ACTIVE
  BLOCKED
  PENDING
}

enum admins_status {
  ACTIVE
  INACTIVE
}

enum fishers_status {
  ACTIVE
  BLOCKED
  PENDING
}

enum fisher_debts_status {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
}
